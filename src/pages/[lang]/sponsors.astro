---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/navbar.astro";
import ParallelogramButton from "../../components/parallelogramButton.astro";

import { sponsors } from "../../data/sponsors";
const categories = Object.entries(sponsors)

import { translations } from "../../i18n/translations";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;


function chunkArray<T>(arr: T[], size: number): T[][] {
  const chunks: T[][] = []
  for (let i = 0; i < arr.length; i += size) {
    chunks.push(arr.slice(i, i + size))
  }
  return chunks
}

const categoryClasses: Record<string, string> = {
  platinum: "w-[15em]",
  gold: "w-[11.5em]",
  silver: "w-[9em]",
  bronze: "w-[8em] h-[7em]",
  partners: "w-[8em] h-[7em]"
};
const rowSizes: Record<string, number> = {
  platinum: 3,
  gold: 3,
  silver: 3,
  bronze: 5,
  partners: 6
};
---

<Layout>
  <div class="max-w-[120em] mx-auto my-20 px-12">
    <h1 class="text-black dark:text-white text-[3.5em] text-left" id="sponsors">
      {t.sponsors}
    </h1>

    <article class="bg-white text-black mt-8 mb-25 shadow-2xl">
      {categories.map(([category, items], i) => {
        const rows = chunkArray(items, rowSizes[category])

        return (
          <>
            <div class="max-w-[120em] mx-auto">

              <h2 class="text-[1.7em] text-center md:text-[2.2em] pl-6 my-6 pt-6 md:text-left">
                {`${t[category as keyof typeof t]}`}
              </h2>

              {rows.map((row) => (
                <div class="flex flex-wrap justify-center gap-15 px-10 pb-6 min-h-30">
                  {row.map((sponsor: { altName: string; link: string; image: string; classes?: string }) => (
                    <a
                      href={sponsor.link}
                      target="_blank"
                      class={`${sponsor.classes ?? ""} ${categoryClasses[category]}  flex items-center justify-center`}
                    >
                      <img
                        src={sponsor.image}
                        alt={sponsor.altName}
                        loading="lazy"
                        decoding="async"
                        class={`${sponsor.classes ?? ""} object-contain `}
                      />
                    </a>
                  ))}
                </div>
              ))}

            </div>

            {i !== categories.length - 1 && (
              <div class="bg-[#f50] h-px w-full"></div>
            )}
          </>
        )
      })}
    </article>
    <h1 class="text-[2.5em] md:text-[3.5em] dark:text-white mx-auto text-center" id="Interested">{t.interested}</h1>
    <ParallelogramButton
        link={`/${lang}/contacts`}
        text={t.contact_us}
      />
  </div>
</Layout>