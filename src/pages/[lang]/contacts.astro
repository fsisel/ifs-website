---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css"

import { translations } from "../../i18n/translations";

const TeamLeaderPhone = "+351 925 732 781";
export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
---
<script>
  const copyVal = document.getElementById("copy")
  const TeamLeaderPhone = "+351 925 732 781";
  if(copyVal)
    {copyVal.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(TeamLeaderPhone.trim());
        console.log("Copied to clipboard");
        alert("Copiado")
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });
  }
</script>
<Layout>
    <Navbar/>
    <div class="flex justify-center">
      <article class="text-black px-6 sm:px-12 lg:px-24 py-16 flex flex-col min-h-[calc(100dvh-17.5em)] w-full max-w-[120em] dark:text-white">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl mb-8 lg:mb-10">{t.contacts}</h1>
        <div class="bg-[#f5f5f5] grid gap-10 p-6 sm:p-8 lg:p-10 dark:bg-[#181818] rounded-sm">
          <div class="flex flex-col sm:flex-row sm:justify-between">
            <div class="text-2xl sm:text-3xl mb-2 mr-2 sm:items-center">{t.msgUs}</div>
            <div class="  sm:text-right text-lg"><span class="text-xl sm:text-2xl mr-0.5 ">Email:</span><a href="mailto:formulastudent@isel.pt" class="hover:underline sm:text-xl break-all">
                formulastudent@isel.pt
                </a><br><span class="text-xl sm:text-2xl mr-2 ">Tel.: </span> {TeamLeaderPhone}
              </div>  
          </div> 
          <div class="px-0 sm:px-10 lg:px-20 mt-3.5">
            <!-- Form -->
            <form
            class="flex flex-col gap-5"
              target="_blank"
              method="POST"
              action="https://formsubmit.co/formulastudent@isel.pt"
            >

              <div class="flex flex-col gap-2">
                <label for="inputEmail4" class="font-medium">Email</label>
                <input
                  type="email"
                  id="inputEmail4"
                  name="email"
                  placeholder={t.emailTxt}
                  required
                  class="bg-white text-black border border-zinc-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500"
                />
              </div>
              <div class="flex flex-col gap-2">
                <label for="name" class="font-medium">{t.entityName}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder={t.entityTxt}
                  required
                  class="bg-white text-black border border-zinc-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500"
                />
              </div>
              <div class="flex flex-col gap-2">
                <label for="message" class="font-medium">{t.writeMsg}</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder={t.writeTxt}
                  required
                  class="bg-white text-black border border-zinc-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500"
                ></textarea>
              </div>

              <input
              type="hidden"
              name="_cc"
              value="pedro.costa@iselfs.pt,martim-jorge@iselfs.pt"
              />
              
              <button
              type="submit"
                class="group relative flex w-full sm:w-[70%] lg:w-[50%] my-6 skew-x-[-18deg] mx-auto"
              >
                <div class="bg-white w-full h-[3em] flex items-center justify-center text-[#f50] font-bold text-sm sm:text-base dark:bg-black border-[0.3em] border-[#f50] transition duration-200 group-hover:bg-[#f50] group-hover:text-white">
                  {t.submit}
                </div>
              </button>

            </form>
          </div>  
         <!-- <div class="text-2xl sm:text-3xl mb-2 mr-2 sm:items-center">You can also contact us via:</div>
           Email section -->
