---
import Layout from "../../layouts/Layout.astro";

import { translations } from "../../i18n/translations";
import {text} from "../../data/car.js"

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;


---
<script>
    function scrollRight() {
        const container = document.getElementById('scrollContainer');
        const container1 = document.getElementById('scrollContainer1');
        const container2 = document.getElementById('scrollContainer2');
        container?.scrollBy({ left: 300, behavior: 'smooth' });
        container1?.scrollBy({ left: 300, behavior: 'smooth' });
        container2?.scrollBy({ left: 300, behavior: 'smooth' });
    }
    document.getElementById("scrollRightButton")?.addEventListener('click', scrollRight);
    document.getElementById("scrollRightButton1")?.addEventListener('click', scrollRight);
    document.getElementById("scrollRightButton2")?.addEventListener('click', scrollRight);
</script>
<script
  type="module"
  src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js">
</script>
<style>
/* Hide scrollbar (optional) */
.no-scrollbar::-webkit-scrollbar {
display: none;
}
.no-scrollbar {
