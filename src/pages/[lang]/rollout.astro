---
import RolloutHero from "../../components/RolloutHero.astro";


import Layout from "../../layouts/Layout.astro"

import { translations } from "../../i18n/translations";
import { text } from "../../data/rollout";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}

type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
const r = text[lang] ?? text.en;


const images = [
  { src: '/images/rollout_06/img1.webp', alt: 'Horizontal 1', orientation: 'horizontal' },
  { src: '/images/rollout_06/img2.webp', alt: 'Vertical 1', orientation: 'vertical' },
  { src: '/images/rollout_06/img3.webp', alt: 'Horizontal 2', orientation: 'horizontal' },
  { src: '/images/rollout_06/img4.webp', alt: 'Vertical 2', orientation: 'vertical' },
  { src: '/images/rollout_06/img5.webp', alt: 'Horizontal 3', orientation: 'horizontal' },
];



---
<Layout>


    <RolloutHero
    over="Rollout"
    title="IFS 06"
    subtitle={t.newCreation}
    imageUrl="/images/rollout_IFS05_I54.webp"
    targetDate="2026-07-11T00:00:00"
  />
<br>
<br>
<br>
<div>
  <p class="flex justify-items-center text-black dark:text-white lg:mx-50">
    Um enorme obrigado a todos os que se juntaram a nós no nosso evento de lançamento! Ficámos muito felizes por ver tantas caras conhecidas e por partilhar a nossa visão convosco. Ter o vosso apoio neste passo tão importante significa muito para nós. Obrigado por terem tornado este dia verdadeiramente especial!
  </p>
</div>  

<div class="max-w-6xl mx-auto p-6" id="gallery-container">
  <!-- Grid layout that respects viewport height -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-auto md:h-[70vh] min-h-[400px]">
    
    <!-- Main Image Display -->
    <!-- Changed to flex for centering and removed fixed overflow that cuts off elements -->
    <div class="md:col-span-2 rounded-xl shadow-2xl bg-black flex items-center justify-center overflow-hidden">
      <img 
        id="main-image"
        src={images[0].src} 
        alt={images[0].alt} 
        class="w-full h-full object-contain transition-opacity duration-300 rounded-xl" 
      />
    </div>

    <!-- Scrollable Thumbnails -->
    <!-- Added h-full and overflow-y-auto to contain it within the grid -->
    <div class="md:col-span-1 overflow-y-auto px-2 pt-2 space-y-4 h-full scrollbar-hide">
      {images.map((img) => (
        <button 
          data-src={img.src}
          data-alt={img.alt}
          class="thumb-btn w-full rounded-lg overflow-hidden shadow-sm aspect-video hover:ring-2 ring-blue-400 transition-all"
        >
          <img src={img.src} alt={img.alt} class="w-full h-full object-cover" />
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  const mainImage = document.getElementById('main-image') as HTMLImageElement;
  const buttons = document.querySelectorAll('.thumb-btn');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const newSrc = button.getAttribute('data-src');
      const newAlt = button.getAttribute('data-alt');
      
      // Update the main image
      if (mainImage && newSrc) {
        mainImage.style.opacity = '0';
        setTimeout(() => {
          mainImage.src = newSrc;
          mainImage.alt = newAlt || '';
          mainImage.style.opacity = '1';
        }, 150);
      }
    });
  });
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<style>
  /* Optional: Hide scrollbar for a cleaner look */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
  

</Layout>