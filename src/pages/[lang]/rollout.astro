---
import RolloutHero from "../../components/RolloutHero.astro";
import HeroImage from "../../components/heroImage.astro"   
import CountDown from "../../components/countDown.astro";

import Layout from "../../layouts/Layout.astro"

import { translations } from "../../i18n/translations";
import {fundMe} from "../../data/fund_me"

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}

type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
const f = fundMe[lang] ?? fundMe.en;

---
<Layout>


    <RolloutHero
    over="Rollout"
    title="IFS 06"
    subtitle="A nossa ultima Criação"
    imageUrl="/images/rollout_IFS05_I54.webp"
    targetDate="2026-07-11T00:00:00"
  />

  <div class="max-w-[98%] sm:max-w-[120em] pt-10 mx-auto">
    <div class=" w-[95%] relative aspect-video mx-auto sm:w-[80%] my-10 flex flex-col gap-10">
            
      
      <iframe
        class="w-full h-full object-cover rounded"
        src="https://www.youtube.com/embed/fdGWRq1dVBA?start=27&autoplay=1&mute=1&loop=1"
        title="Video"
        allowfullscreen
      ></iframe>
      <!-- <video
        class="w-full h-full object-cover rounded"
        autoplay
        muted
        loop
        playsinline
        controls
      >
        <source src="/videos/ifs_rollout05.webm" type="video/webm" />
      </video> -->

      
      <div class="text-white w-[40%] mx-auto rounded bg-[#181818] p-5 mb-30">
        <p class="text-xl">Join us at the ISEL Grand Auditorium as we showcase the pinnacle of student engineering. Be the first to witness the evolution of the IFS-06.</p>
        <div class="flex flex-col gap-5 mt-3">
          <div class="flex flex-row">
            <!-- icon -->
            <div class="bg-[#282828] rounded-4xl p-2 mr-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-12 h-12 my-auto mx-2 p-1 "
              >
                <path d="M8 2v4"/>
                <path d="M16 2v4"/>
                <rect width="18" height="18" x="3" y="4" rx="2"/>
                <path d="M3 10h18"/>
            </svg>
            </div>
            
            <div class="flex flex-col">
              <div class="text-lg font-bold text-[#f50] "><!-- date -->Date</div>
              <div class="text-3xl "><!-- details -->July 11, 2026</div>
            </div>
          </div>

          <div class="flex flex-row">
            <!-- icon -->
            <div class="bg-[#282828] rounded-4xl p-2 mr-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-12 h-12 my-auto mx-2 p-1 "
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            
            <div class="flex flex-col">
              <div class="text-lg font-bold text-[#f50] "><!-- date -->Location</div>
              <div class="text-3xl "><!-- details -->ISEL Main Auditorium </div>
            </div>
          </div>
        

        </div>

      </div>



      

      </div>
    </div>
  </div>
</Layout>