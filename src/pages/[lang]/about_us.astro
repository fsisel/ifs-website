---
import Layout from "../../layouts/Layout.astro"
import Navbar from "../../components/navbar.astro"
import Footer from "../../components/Footer.astro"
import ContentBlock from "../../components/contentBlock.astro";

import {text} from "../../data/about_us"
import { translations } from "../../i18n/translations";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
---

<Layout>
    <Navbar/>
    <div class="mt-10 bodier contentBlocks  text-black dark:text-white">
        <h2 class="text-[56px]">{t.aboutUs}</h2>
        <ContentBlock 
            imageSrc="/images/fsg_teams.webp"
            imageAlt="FSG Teams"
            title={t.competition}
            text=""
        />
        <ContentBlock 
            imageSrc="/images/ifs02_1.webp"
            imageAlt="IFS02"
            title={t.project}
            text=""
            reverse
        />

    </div>
    <Footer/>
</Layout>

