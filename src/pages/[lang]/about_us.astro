---
import Layout from "../../layouts/Layout.astro"
import Navbar from "../../components/navbar.astro"
import Footer from "../../components/Footer.astro"
import ContentBlock from "../../components/contentBlock.astro";

import {text} from "../../data/about_us"
import { translations } from "../../i18n/translations";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
const abt = text[lang] ?? text.en;
---

<Layout>
    <Navbar/>
    <div class="max-w-[120em] mt-20 mb-20 mx-auto px-[7vw] text-black dark:text-white">
        <h2 class="text-[3.5em]">{t.aboutUs}</h2>
        <ContentBlock 
            imageSrc="/images/fsg_teams.webp"
            imageAlt="FSG Teams"
            title={t.competition}
            text={abt.compTxt}
        />
        <ContentBlock 
            imageSrc="/images/ifs02_1.webp"
            imageAlt="IFS02"
            title={t.project}
            text={abt.projecTxt}
            reverse
        />
        <div class="bg-[#f5f5f5] dark:bg-[#181818] dark:text-white mt-10 py-5 px-10 shadow-lg" >
            <h2 class="text-[2.2em] font-bold pb-4">{abt.history}</h2>
            <div set:html={abt.historyTxt} class="text-[1.4em] flex flex-col gap-5"></div>
        </div>
    </div>
    <Footer/>
</Layout>

