---
import Layout from "../../layouts/Layout.astro";
import { translations } from "../../i18n/translations";
// Assuming you exported 'garage' from this file based on our previous step
import { garage } from "../../data/garage.js"; 

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}

type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;

// Default car to load first
const defaultCarId = "ifs05";
---

<script>
    function scrollRight() {
        const container = document.getElementById('scrollContainer');
        container?.scrollBy({ left: 204, behavior: 'smooth' });
    }
    document.getElementById("scrollRightButton")?.addEventListener('click', scrollRight);
</script>

<script
  type="module"
  src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js">
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<Layout>
  <div class="min-h-screen bg-[#f5f5f5] text-black dark:bg-black dark:text-white font-sans overflow-x-hidden selection:bg-[#f50] selection:text-white pb-6">
    
    <div class="max-w-6xl mx-auto relative border-x border-[#222] min-h-[90vh] flex flex-col mt-16 lg:mt-24">
      
      <div class="absolute inset-0 pointer-events-none flex justify-center items-center z-0">
        <div class="w-full h-[1px] bg-[#222]"></div>
        <div class="h-full w-[1px] bg-[#222]"></div>
      </div>

      <div class="relative w-full pt-10 pb-16 px-4 flex flex-col items-center justify-center z-10 group" id="displayContainer">
        
        <button id="activateModel" class="absolute top-6 right-6 lg:top-8 lg:right-24 z-20 flex items-center gap-2 bg-[#1a1a1a]/80 text-white/50 hover:text-white backdrop-blur-sm px-4 py-2 rounded-full border border-white/5 hover:border-[#f50]/50 transition-all duration-300">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
            </svg>
            <span class="text-[9px] font-bold tracking-widest uppercase">360º View</span>
        </button>

        <div id="mediaViewer" class="relative w-full max-w-4xl flex justify-center items-center min-h-[400px]">
            <img id="mainImage" src="" alt="Vehicle" class="w-[90%] lg:w-[75%] h-auto object-contain transition-transform duration-500" />
            
            <button id="closeModel" class="absolute top-6 right-6 z-30 bg-[#1a1a1a]/80 p-2 rounded-full hidden hover:bg-[#f50] text-white transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
      </div>

      <div class="text-center mt-[-40px] mb-12 relative z-10">
        <h1 id="carTitle" class="text-6xl lg:text-8xl font-black tracking-tighter mb-2">
          </h1>
        <h2 id="carSubtitle" class="text-xs lg:text-sm tracking-[0.4em] text-white/60 font-medium uppercase">
          </h2>
      </div>

      <div id="detailsContainer" class="flex flex-col md:flex-row gap-4 w-full px-4 lg:px-8 mb-16 relative z-20 flex-wrap justify-center">
        </div>

      <div class="bg-black/50 border-t border-[#222] p-4 relative z-10 w-full">
        <div class="flex justify-between items-end mb-3 px-2 lg:px-6">
          <h3 class="text-[10px] tracking-widest text-white/40 font-semibold">SELECT MODEL</h3>
          <button 
            id="scrollRightButton"
            class="text-[9px] tracking-widest text-[#f50] hover:text-white font-semibold flex items-center gap-1.5 transition-colors cursor-pointer border border-[#f50]/30 px-2.5 py-1 rounded-full hover:bg-[#f50]/10"
          >
            SCROLL <span class="text-sm leading-none">→</span>
          </button>
        </div>

        <div id="scrollContainer" class="flex gap-3 overflow-x-auto pb-2 scroll-smooth no-scrollbar snap-x px-2 lg:px-6">
          
          <div class="car-selector relative w-60 h-auto bg-[#0a0a0a] rounded-lg border border-white/10 overflow-hidden group hover:border-[#f50]/40 transition-colors snap-start shrink-0 cursor-pointer" data-car-id="ifs06">
            <div class="w-full h-full bg-[#1a1a1a] flex items-center justify-center">
                <img src="/images/ifs05-lateral.webp" alt="IFS06" class="w-[70%] opacity-90 pointer-events-none" />
            </div>
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/10 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-2 left-3 text-[11px] font-bold text-white/50 group-hover:text-white transition-colors pointer-events-none">IFS-06</span>
          </div>
          
          <div class="car-selector relative w-60 h-auto bg-[#0a0a0a] rounded-lg border border-white/10 overflow-hidden group hover:border-[#f50]/40 transition-colors snap-start shrink-0 cursor-pointer" data-car-id="ifs05">
            <div class="w-full h-full bg-[#1a1a1a] flex items-center justify-center">
                <img src="/images/ifs05-lateral.webp" alt="IFS05" class="w-[70%] opacity-90 pointer-events-none" />
            </div>
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/10 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-2 left-3 text-[11px] font-bold text-[#f50] pointer-events-none">IFS-05</span>
          </div>
          
          <div class="car-selector relative w-60 h-auto bg-[#0a0a0a] rounded-lg border border-white/10 overflow-hidden group hover:border-[#f50]/40 transition-colors snap-start shrink-0 cursor-pointer" data-car-id="ifs04">
            <div class="w-full h-full bg-[#1a1a1a] flex items-center justify-center">
                <img src="/images/ifs04-lateral.webp" alt="IFS04" class="w-[70%] opacity-90 pointer-events-none" />
            </div>
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/10 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-2 left-3 text-[11px] font-bold text-white/50 group-hover:text-white transition-colors pointer-events-none">IFS-04</span>
          </div>

           <div class="car-selector relative w-60 h-auto bg-[#0a0a0a] rounded-lg border border-white/10 overflow-hidden group hover:border-[#f50]/40 transition-colors snap-start shrink-0 cursor-pointer" data-car-id="ifs03">
            <div class="w-full h-full bg-[#1a1a1a] flex items-center justify-center">
                <img src="/images/ifs03_right.webp" alt="IFS03" class="w-[70%] opacity-90 pointer-events-none" />
            </div>
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/10 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-2 left-3 text-[11px] font-bold text-white/50 group-hover:text-white transition-colors pointer-events-none">IFS-03</span>
          </div>
          
           <div class="car-selector relative w-60 h-auto bg-[#0a0a0a] rounded-lg border border-white/10 overflow-hidden group hover:border-[#f50]/40 transition-colors snap-start shrink-0 cursor-pointer" data-car-id="ifs02">
            <div class="w-full h-full bg-[#1a1a1a] flex items-center justify-center">
                <img src="/images/ifs02-lateral.webp" alt="IFS02" class="w-[70%] opacity-90 pointer-events-none" />
            </div>
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/10 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-2 left-3 text-[11px] font-bold text-white/50 group-hover:text-white transition-colors pointer-events-none">IFS-02</span>
          </div>
           
          <div class="car-selector relative w-60 h-auto bg-[#0a0a0a] rounded-lg border border-white/10 overflow-hidden group hover:border-[#f50]/40 transition-colors snap-start shrink-0 cursor-pointer" data-car-id="ifs01">
            <div class="w-full h-full bg-[#1a1a1a] flex items-center justify-center">
                <img src="/images/ifs01-lateral.webp" alt="IFS01" class="w-[70%] opacity-90 pointer-events-none" />
            </div>
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/10 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-2 left-3 text-[11px] font-bold text-white/50 group-hover:text-white transition-colors pointer-events-none">IFS-01</span>
          </div>

        </div>
      </div>
      
    </div>
  </div>
</Layout>

<script define:vars={{ garageData: garage, currentLang: lang, defaultCar: defaultCarId }}>
    const displayContainer = document.getElementById('displayContainer');
    const mediaViewer = document.getElementById('mediaViewer');
    const mainImage = document.getElementById('mainImage');
    const activateBtn = document.getElementById('activateModel');
    const closeBtn = document.getElementById('closeModel');
    const detailsContainer = document.getElementById('detailsContainer');
    const titleEl = document.getElementById('carTitle');
    const subtitleEl = document.getElementById('carSubtitle');
    
    let currentModelPath = '';

    function renderCar(carId) {
        const langData = garageData[currentLang] || garageData['en'];
        const car = langData[carId];
        if (!car) return;

        // 1. Reset Title
        titleEl.innerHTML = '';
        titleEl.className = "text-6xl lg:text-8xl font-black tracking-tighter mb-2";

        // 2. Nickname Logic
        if (car.nicknameImage) {
            const img = document.createElement('img');
            img.src = car.nicknameImage;
            img.alt = "Nickname";
            img.className = "h-16 lg:h-24 mx-auto object-contain";
            titleEl.appendChild(img);
        } else if (car.nickname) {
            titleEl.textContent = car.nickname;
        } else {
            const prefix = carId.substring(0, 3).toUpperCase();
            const number = carId.substring(3);
            titleEl.innerHTML = `<span class="text-white">${prefix}</span><span class="text-[#f50]">${number}</span>`;
        }
        
        // 3. Subtitle Logic: Only show if description exists
        if (car.description) {
            subtitleEl.textContent = car.description;
            subtitleEl.classList.remove('hidden');
        } else {
            subtitleEl.textContent = '';
            subtitleEl.classList.add('hidden');
        }

        // 4. Media
        if (car.media) {
            mainImage.src = car.media.thumbnail;
            currentModelPath = car.media.model;
        }

        // 5. Details Rendering
        let html = '';
        const skipKeys = ['nickname', 'nicknameimage', 'description', 'media'];

        for (const [category, fields] of Object.entries(car)) {
            if (skipKeys.includes(category.toLowerCase())) continue;
            
            // Only add if there is actual data in the fields
            html += `
                <div class="flex-1 min-w-[200px] bg-[#151515] border border-white/5 rounded-lg p-5 shadow-xl hover:border-[#f50]/30 transition-colors">
                    <h3 class="font-bold text-[#f50] mb-4 text-[10px] tracking-widest uppercase">${category}</h3>
                    <div class="space-y-3 text-sm">
                        ${renderFields(fields)}
                    </div>
                </div>
            `;
        }
        detailsContainer.innerHTML = html;
        
        // Hide the container if no tabs were created
        if (html.trim() === '') {
            detailsContainer.classList.add('hidden');
        } else {
            detailsContainer.classList.remove('hidden');
        }

        // ... (Keep your existing active state logic for the car-selector)
    }

    function renderFields(fields) {
        if (typeof fields === 'string') {
            return `<p class="text-sm text-white/60 leading-relaxed">${fields}</p>`;
        }
        return Object.entries(fields).map(([key, value]) => `
            <div class="flex justify-between border-b border-white/10 pb-1">
                <span class="text-white/60">${key.replace(/_/g, ' ')}</span>
                <span class="font-bold text-white text-right max-w-[60%]">${value || 'TBA'}</span>
            </div>
        `).join('');
    }

    document.querySelectorAll('.car-selector').forEach(card => {
        card.addEventListener('click', (e) => {
            const id = e.currentTarget.getAttribute('data-car-id');
            renderCar(id);
        });
    });

    displayContainer?.addEventListener('click', (e) => {
        if (e.target !== closeBtn && !document.querySelector('model-viewer') && currentModelPath) {
            mainImage.classList.add('hidden');
            activateBtn.classList.add('hidden');
            closeBtn.classList.remove('hidden');

            const modelHtml = `
                <model-viewer 
                    src="${currentModelPath}" 
                    camera-controls auto-rotate disable-pan 
                    max-camera-orbit="auto 100deg auto" 
                    style="width:100%;height:400px;">
                </model-viewer>
            `;
            mediaViewer.insertAdjacentHTML('beforeend', modelHtml);
        }
    });

    closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const modelViewer = document.querySelector('model-viewer');
        modelViewer?.remove();
        mainImage.classList.remove('hidden');
        if(currentModelPath) activateBtn.classList.remove('hidden');
        closeBtn.classList.add('hidden');
    });

    renderCar(defaultCar);
</script>