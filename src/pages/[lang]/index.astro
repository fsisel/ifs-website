---
import Layout from '../../layouts/Layout.astro';

import ParallelogramButton from '../../components/parallelogramButton.astro';
import ContentBlock from '../../components/contentBlock.astro';
import { blocks } from "../../data/blocks";


export interface Props {
  children: any;
}

import { translations } from "../../i18n/translations";
import {fundMEbanner} from "../../data/fundMebanner"
import Image from 'astro/components/Image.astro';

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
const b = fundMEbanner[lang] ?? fundMEbanner.en;

const otherLang = lang === "en" ? "pt" : "en";




---
<script>
const target = document.querySelector("#navbar");

window.addEventListener("scroll", () => {
  if(!target!)return;
  if (window.scrollY <= 219 && window.outerWidth>=768) {
    target.classList.add("-translate-y-12");
  }else {
    target.classList.remove("-translate-y-12");
  }
});
const targetDate = "2026-07-19T00:00:00";
const targetTimer = new Date(targetDate).getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const diff = targetTimer - now;

    if (diff <= 0) {
      const countdownElement = document.getElementById("countdown");
      if(countdownElement){
        countdownElement.innerText = "Time's up";
        return;
      }
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((diff / (1000 * 60)) % 60);
    const seconds = Math.floor((diff / 1000) % 60);

    const daysElement = document.getElementById("days");
    const hoursElement = document.getElementById("hours");
    const minutesElement = document.getElementById("minutes");
    const secondsElement = document.getElementById("seconds");

    if (daysElement) daysElement.innerText = String(days);
    if (hoursElement) hoursElement.innerText = String(hours);
    if (minutesElement) minutesElement.innerText = String(minutes);
    if (secondsElement) secondsElement.innerText = String(seconds);
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);

function tick() {
  updateCountdown();
  setTimeout(tick, 1000);
}

tick();
</script>

<Layout>
  <header class="hidden md:flex items-center justify-between w-full bg-black shadow-md absolute top-0 left-0 z-50 px-[7vw] py-5 text-white" id="header" >
    <div class="flex items-center gap-3">
      <a href={`/${lang}/`}>
        <img src="/logos/ifs_logo_dark.svg" alt="ISEL Formula Student" class=" h-auto w-full " />
      </a>
    </div>
    <div class="flex items-center justify-center gap-8">
      <div class="flex flex-col text-right md:flex items-right gap-4 font-bold tracking-wide text-[20.8px] ">
        <a href={`/${lang}/about_us`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.aboutUs}
        </a>
        <a href={`/${lang}/ifs05`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        IFS05
        </a>
        <a href={`/${lang}/sponsors`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.sponsors}
        </a>
        <a href={`/${lang}/contacts`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.contacts}
        </a>
        <a href={`/${lang}/fundme`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.crowdFunding}
        </a>
      </div>
    
      <div>
        <!-- Language Switch -->
        <div class="h-full">
          <a href={`/${otherLang}/`} title="Português">
            <img src={`/icons/${otherLang}.svg`} alt="Portuguese" class="h-6 w-6 rounded-sm" />
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button
        id="menu_button"
        class="md:hidden flex items-center gap-2 text-sm font-semibold"
        >
          MENU
          <img src="/icons/menu.svg" alt="Menu" class="h-5 w-5" />
        </button>
      </div>	
    </div>	
  </header>
  <section class="relative w-full">
    <!-- Image -->
    <Image 
      src="/images/Team04_fspt_1-1.webp"
      alt={(lang == "en")? "Team FSPT 2024" : "Equipa FSPT 2024"}
      class="h-[35vh] w-full md:h-[85vh] max-h-[65em] object-cover"
      width={1600}
      height={1040}
    />

    <!-- Overlay content -->
    <div class="contentBlocks">
      <div class="w-full justify-center items-center py-12">
  <div class="bg-[#f5f5f5] text-black w-full dark:bg-[#181818] shadow-lg overflow-hidden dark:text-white">
    
    <div class="w-full p-8 md:p-14 flex flex-col justify-center items-center text-center">
      
      <p class="text-[35.2px] font-black uppercase tracking-tight leading-none mb-6" set:html={b.title}></p>

      <p class="text-[22.4px] max-w-2xl" set:html={b.description}></p>

      <div class="mt-8">
        <ParallelogramButton
          link="fundme"
          text={b.cta}
        />
      </div>

    </div>

  </div>
</div>
      <div class="max-w-[120em] my-[2em] px-[7vw] bg-[#f5f5f5] text-black dark:bg-[#181818] dark:text-white flex flex-col items-center py-10">
    
        <!-- Logo -->
        <img src="/logos/FSPT.webp" alt="FSPT" class="w-150 h-auto mx-auto">
        <div class="w-[90%] border-b border-white/20 mt-8 mx-auto"></div>

        <!-- Subtitle -->
        <p class="text-white/40 uppercase tracking-widest text-xs mt-8 mb-6">{t.compIn}</p>

        <!-- Countdown blocks -->
        <div id="countdown" class="flex flex-row gap-4 md:gap-8  w-full">
          <div class="w-[50%] flex flex-row justify-end">
            <div class="flex flex-col items-center px-6 py-4 min-w-20">
              <span id="days" class="font-mono text-5xl md:text-6xl font-bold text-white tabular-nums">00</span>
              <span class="text-white/40 uppercase tracking-widest text-xs mt-2">{t.days}</span>
            </div>
      
            <span class="text-white/30 text-4xl font-thin self-center mb-4">:</span>
      
            <div class="flex flex-col items-center px-6 py-4 min-w-20">
              <span id="hours" class="font-mono text-5xl md:text-6xl font-bold text-white tabular-nums">00</span>
              <span class="text-white/40 uppercase tracking-widest text-xs mt-2">{t.hours}</span>
            </div>
      
            <span class="text-white/30 text-4xl font-thin self-center mb-4">:</span>

          </div>
          <div class="flex flex-row justify-start">

            <div class="flex flex-col items-center pr-6 py-4 min-w-20">
              <span id="minutes" class="font-mono text-5xl md:text-6xl font-bold text-white tabular-nums">00</span>
              <span class="text-white/40 uppercase tracking-widest text-xs mt-2">{t.minutes}</span>
            </div>
            
            <span class="text-white/30 text-4xl font-thin self-center mb-4">:</span>
            
            <div class="flex flex-col items-center px-6 py-4 min-w-20">
              <span id="seconds" class="font-mono text-5xl md:text-6xl font-bold text-white tabular-nums">00</span>
              <span class="text-white/40 uppercase tracking-widest text-xs mt-2">{t.seconds}</span>
            </div>
            
          </div>
        </div>
      </div>
    </div>

    <div class="contentBlocks">  
      {blocks.map((block, index) => (
        
        <ContentBlock
        imageSrc={block.image}
        imageAlt={(block.title as Record<string, any>)[lang] ?? block.title}
        title={(block.title as Record<string, any>)[lang] ?? block.title}
        text={block.text[lang]}
        button={block.button?.[lang]}
        reverse={index % 2 !== 0}
        loading={index <=1 ? true:false}
        />
      ))}

    </div>
  </section>
</Layout>
