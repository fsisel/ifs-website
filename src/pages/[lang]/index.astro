---
import Layout from '../../layouts/Layout.astro';

import ParallelogramButton from '../../components/parallelogramButton.astro';
import CountDown from '../../components/countDown.astro';
import ContentBlock from '../../components/contentBlock.astro';
import { blocks } from "../../data/blocks";


export interface Props {
  children: any;
}

import { translations } from "../../i18n/translations";
import {fundMEbanner} from "../../data/fundMebanner"
import Image from 'astro/components/Image.astro';

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
const b = fundMEbanner[lang] ?? fundMEbanner.en;

const otherLang = lang === "en" ? "pt" : "en";



---
<script>
const target = document.querySelector("#navbar");

window.addEventListener("scroll", () => {
  if(!target!)return;
  if (window.scrollY <= 219 && window.outerWidth>=768) {
    target.classList.add("-translate-y-12");
  }else {
    target.classList.remove("-translate-y-12");
  }
});
</script>

<Layout>
  <header class="hidden md:flex items-center justify-between w-full bg-black shadow-md absolute top-0 left-0 z-50 px-[7vw] py-5 text-white" id="header" >
    <div class="flex items-center gap-3">
      <a href={`/${lang}/`}>
        <img src="/logos/ifs_logo_dark.svg" alt="ISEL Formula Student" class=" h-auto w-full " />
      </a>
    </div>
    <div class="flex items-center justify-center gap-8">
      <div class="flex flex-col text-right md:flex items-right gap-4 font-bold tracking-wide text-[20.8px] ">
        <a href={`/${lang}/about_us`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.aboutUs}
        </a>
        <a href={`/${lang}/rollout`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        Rollout
        </a>
        <a href={`/${lang}/ifs05`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        IFS05
        </a>
        <a href={`/${lang}/sponsors`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.sponsors}
        </a>
        <a href={`/${lang}/contacts`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.contacts}
        </a>
        <a href={`/${lang}/fundme`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out uppercase">
        {t.crowdFunding}
        </a>
      </div>
    
      <div>
        <!-- Language Switch -->
        <div class="h-full">
          <a href={`/${otherLang}/`} title="Português">
            <img src={`/icons/${otherLang}.svg`} alt="Portuguese" class="h-6 w-6 rounded-sm" />
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button
        id="menu_button"
        class="md:hidden flex items-center gap-2 text-sm font-semibold"
        >
          MENU
          <img src="/icons/menu.svg" alt="Menu" class="h-5 w-5" />
        </button>
      </div>	
    </div>	
  </header>
  <section class="relative w-full">
    <!-- Image -->
    <Image 
      src="/images/Team05_fspt.webp"
      alt={(lang == "en")? "Team FSPT 2025" : "Equipa FSPT 2025"}
      class="h-[50vh] w-full md:h-[100vh] object-cover"
      width={1600}
      height={1040}
    />

    <!-- Overlay content -->
    <div class="contentBlocks">
      <div class="w-full justify-center items-center py-12">
        <div class="bg-[#f5f5f5] text-black w-full dark:bg-[#181818] shadow-lg overflow-hidden dark:text-white">
          
          <div class="w-full p-8 md:p-14 flex flex-col justify-center items-center text-center">
            
            <p class="text-[35.2px] font-black uppercase tracking-tight leading-none mb-6" set:html={b.title}></p>

            <p class="text-[22.4px] max-w-2xl" set:html={b.description}></p>

            <div class="mt-8">
              <ParallelogramButton
                link="fundme"
                text={b.cta}
              />
            </div>

          </div>

        </div>
      </div>
      <div class="flex flex-col lg:flex-row justify-center items-stretch gap-4 my-[2em]">

  <div class="px-[4vw] md:px-[7vw] bg-[#f5f5f5] text-black dark:bg-[#181818] dark:text-white flex flex-col items-center py-8 md:py-10 flex-1 lg:max-w-[50%] ">
    <div class="h-20 sm:h-24 flex items-center justify-center w-full">
      <img src="/logos/FSPT.webp" alt="FSPT" class="max-h-full max-w-[70%] object-contain mx-auto">
    </div>
    <div class="w-[90%] border-b border-black/20 dark:border-white/20 mt-8 mx-auto"></div>
    <p class="text-black/40 dark:text-white/40 uppercase tracking-widest text-xs mt-8 mb-6">{t.compIn}</p>
    <CountDown lang={lang} targetDate="2026-07-19T00:00:00" id='fspt-countdown' />
  </div>

  <div class="px-[4vw] md:px-[7vw] bg-[#f5f5f5] text-black dark:bg-[#181818] dark:text-white flex flex-col items-center py-8 md:py-10 flex-1 lg:max-w-[50%]">
    <div class="h-20 sm:h-24 flex items-center justify-center w-full">
      <img src="/logos/fsa-logo.webp" alt="FSA" class="max-h-full max-w-[70%] object-contain mx-auto">
    </div>
    <div class="w-[90%] border-b border-black/20 dark:border-white/20 mt-8 mx-auto"></div>
    <p class="text-black/40 dark:text-white/40 uppercase tracking-widest text-xs mt-8 mb-6">{t.compIn}</p>
    <CountDown lang={lang} targetDate="2026-07-26T00:00:00" id='fsa-countdown' />
  </div>

</div>
    </div>
    </div>

    <div class="contentBlocks">  
      {blocks.map((block, index) => (
        
        <ContentBlock
        imageSrc={block.image}
        imageAlt={(block.title as Record<string, any>)[lang] ?? block.title}
        title={(block.title as Record<string, any>)[lang] ?? block.title}
        text={block.text[lang]}
        button={block.button?.[lang]}
        reverse={index % 2 !== 0}
        loading={index <=1 ? true:false}
        />
      ))}

    </div>
  </section>
</Layout>
