---
import Layout from '../../layouts/Layout.astro';


import ContentBlock from '../../components/contentBlock.astro';
import { blocks } from "../../data/blocks";


export interface Props {
  children: any;
}

import { translations } from "../../i18n/translations";
import Image from 'astro/components/Image.astro';

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;

const otherLang = lang === "en" ? "pt" : "en";

---
<script>
const target = document.querySelector("#navbar");

window.addEventListener("scroll", () => {
  if(!target!)return;
  if (window.scrollY <= 219 && window.outerWidth>=768) {
    target.classList.add("-translate-y-12");
  }else {
    target.classList.remove("-translate-y-12");
  }
});
</script>

<Layout>
  <header class="hidden md:flex items-center justify-between w-full bg-black shadow-md absolute top-0 left-0 z-50 px-[7vw] py-5 text-white" id="header" >
    <div class="flex items-center gap-3">
      <a href={`/${lang}/`}>
        <img src="/logos/ifs_logo_dark.svg" alt="ISEL Formula Student" class=" h-auto w-full " />
      </a>
    </div>
    <div class="flex items-center justify-center gap-8">
      <div class="flex flex-col text-right md:flex items-right gap-4 font-bold tracking-wide text-[20.8px] ">
        <a href={`/${lang}/about_us`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out">
        {t.aboutUs}
        </a>
        <a href={`/${lang}/ifs05`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out">
        IFS05
        </a>
        <a href={`/${lang}/sponsors`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out">
        {t.sponsors}
        </a>
        <a href={`/${lang}/contacts`} class="px-2 border-r-0 hover:border-r-5 border-orange-500 transition-all duration-80 ease-in-out">
        {t.contacts}
        </a>
      </div>
    
      <div>
        <!-- Language Switch -->
        <div class="h-full">
          <a href={`/${otherLang}/`} title="Português">
            <img src={`/icons/${otherLang}.svg`} alt="Portuguese" class="h-6 w-6 rounded-sm" />
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button
        id="menu_button"
        class="md:hidden flex items-center gap-2 text-sm font-semibold"
        >
          MENU
          <img src="/icons/menu.svg" alt="Menu" class="h-5 w-5" />
        </button>
      </div>	
    </div>	
  </header>
  <section class="relative w-full">
    <!-- Image -->
    <Image 
      src="/images/Team04_fspt_1-1.webp"
      alt={(lang == "en")? "Team FSPT 2024" : "Equipa FSPT 2024"}
      class="h-[35vh] w-full md:h-[85vh] max-h-[65em] object-cover"
      width={1600}
      height={1040}
    />

    <!-- Overlay content -->
    
    <div class="bodier contentBlocks">  
      {blocks.map((block, index) => (
        
        <ContentBlock
        imageSrc={block.image}
        imageAlt={(block.title as Record<string, any>)[lang] ?? block.title}
        title={(block.title as Record<string, any>)[lang] ?? block.title}
        text={block.text[lang]}
        button={block.button?.[lang]}
        reverse={index % 2 !== 0}
        loading={index <=1 ? true:false}
        />
      ))}

    </div>
  </section>
</Layout>
