---
import TestingLayout from "../layouts/TestingLayout.astro";
import ContentBlock from "../components/contentBlock.astro";

import {text} from "../data/about_us"
import { translations } from "../i18n/translations";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;
const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;
const abt = text[lang] ?? text.en;

import Team from "../components/team.astro";
import Organogram from "../components/organogram.astro";
import Organogram2 from "../components/organogram2.astro";

---

<TestingLayout>
  <!-- First phone screen (left) -->
  <div style="padding: 1rem; background: #fff; color: #000;">
    <h2 class="text-[2em] mb-4">{t.aboutUs}</h2>
    <ContentBlock 
        imageSrc="/images/fsg_teams.webp"
        imageAlt="FSG Teams"
        title={t.competition}
        text={abt.compTxt}
        loading={true}
    />
    <ContentBlock 
        imageSrc="/images/ifs02_1.webp"
        imageAlt="IFS02"
        title={t.project}
        text={abt.projecTxt}
        reverse
        loading={true}
    />
    <div class="bg-[#f5f5f5] py-5 px-4 shadow-lg my-4">
        <h2 class="text-[1.5em] font-bold pb-4">{abt.history}</h2>
        <div class="text-[1em] flex flex-col gap-3">
            {abt.historyTxt.map(item => (
                <p>{item}</p>
            ))}
        </div>
    </div>
    <Team car='06'/>
  </div>

  <!-- Second phone screen (right) -->
  <div style="padding: 1rem; background: #fff; color: #000;">
    <h2 class="text-[2em] mb-4">{t.aboutUs}</h2>
    <ContentBlock 
        imageSrc="/images/fsg_teams.webp"
        imageAlt="FSG Teams"
        title={t.competition}
        text={abt.compTxt}
        loading={true}
    />
    <ContentBlock 
        imageSrc="/images/ifs02_1.webp"
        imageAlt="IFS02"
        title={t.project}
        text={abt.projecTxt}
        reverse
        loading={true}
    />
    <div class="bg-[#f5f5f5] py-5 px-4 shadow-lg my-4">
        <h2 class="text-[1.5em] font-bold pb-4">{abt.history}</h2>
        <div class="text-[1em] flex flex-col gap-3">
            {abt.historyTxt.map(item => (
                <p>{item}</p>
            ))}
        </div>
    </div>
    <Organogram />
    <Organogram2 />
  </div>
</TestingLayout>