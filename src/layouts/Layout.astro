---
import "../styles/global.css";
import Navbar from "../components/navbar.astro"
import Footer from "../components/Footer.astro";

export interface Props {
  children: any;
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg">
    	<link rel="icon" href="/favicon-92.webp">
		<meta name="generator" content={Astro.generator} />
		<title>ISEL Formula student</title>
	</head>
	<body class="bg-white min-h-screen dark:bg-black ">
		<Navbar />

		<slot /><!-- content -->

		<Footer /> 
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
