---
const { link, text } = Astro.props;

---




<a href={link} class="group relative flex my-8 skew-x-[-18deg] w-fit mx-auto no-underline">

  <div class="absolute left-0 w-6 h-20 bg-[#f50] transition-transform duration-200 group-hover:-translate-x-5"></div>

  <div class=" w-45 h-[4.2em] flex items-center justify-center text-[#f50] font-bold text-[1.2em] bg-black border-[0.3em] border-[#f50] z-10 transition-all duration-200 group-hover:translate-x-3 group-hover:bg-[#f50] group-hover:text-white">
    {text}
  </div>

</a>