---
import { translations } from "../i18n/translations";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}

type Lang = keyof typeof translations;

interface Props {
  lang: Lang;
  targetDate: string; // ISO string e.g. "2026-07-19T00:00:00"
  id?: string;        // unique id when using multiple instances, default "countdown"
}

const { lang, targetDate, id = "countdown" } = Astro.props;
const t = translations[lang] ?? translations.en;
---

<script define:vars={{ targetDate, id }}>
  const targetTimer = new Date(targetDate).getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const diff = targetTimer - now;

    const countdownElement = document.getElementById(id);

    if (diff <= 0) {
      if (countdownElement) countdownElement.innerText = "Time's up";
      return;
    }

    const days    = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours   = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((diff / (1000 * 60)) % 60);
    const seconds = Math.floor((diff / 1000) % 60);

    const daysEl    = document.getElementById(`${id}-days`);
    const hoursEl   = document.getElementById(`${id}-hours`);
    const minutesEl = document.getElementById(`${id}-minutes`);
    const secondsEl = document.getElementById(`${id}-seconds`);

    if (daysEl)    daysEl.innerText    = String(days);
    if (hoursEl)   hoursEl.innerText   = String(hours);
    if (minutesEl) minutesEl.innerText = String(minutes);
    if (secondsEl) secondsEl.innerText = String(seconds);
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>

<div id={id} class="flex flex-row justify-center items-center gap-1 w-full px-2">

  <div class="flex flex-col items-center py-4 flex-1 min-w-0">
    <span id={`${id}-days`} class="font-mono text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black dark:text-white tabular-nums">00</span>
    <span class="text-black/40 dark:text-white/40 uppercase tracking-widest text-[8px] sm:text-xs mt-2">{t.days}</span>
  </div>

  <span class="text-black/30 dark:text-white/30 text-xl sm:text-3xl md:text-4xl font-thin self-center mb-4 shrink-0 sm:px-10 ">:</span>

  <div class="flex flex-col items-center py-4 flex-1 min-w-0">
    <span id={`${id}-hours`} class="font-mono text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black dark:text-white tabular-nums">00</span>
    <span class="text-black/40 dark:text-white/40 uppercase tracking-widest text-[8px] sm:text-xs mt-2">{t.hours}</span>
  </div>

  <span class="text-black/30 dark:text-white/30 text-xl sm:text-3xl md:text-4xl font-thin self-center mb-4 shrink-0 sm:px-10">:</span>

  <div class="flex flex-col items-center py-4 flex-1 min-w-0">
    <span id={`${id}-minutes`} class="font-mono text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black dark:text-white tabular-nums">00</span>
    <span class="text-black/40 dark:text-white/40 uppercase tracking-widest text-[8px] sm:text-xs mt-2">{t.minutes}</span>
  </div>

  <span class="text-black/30 dark:text-white/30 text-xl sm:text-3xl md:text-4xl font-thin self-center mb-4 shrink-0 sm:px-10">:</span>

  <div class="flex flex-col items-center py-4 flex-1 min-w-0">
    <span id={`${id}-seconds`} class="font-mono text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black dark:text-white tabular-nums">00</span>
    <span class="text-black/40 dark:text-white/40 uppercase tracking-widest text-[8px] sm:text-xs mt-2">{t.seconds}</span>
  </div>

</div>