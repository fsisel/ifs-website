---
export interface Props {
  imageSrc: string;
  imageAlt: string;
  title: string;        // may contain HTML
  text: string;        // may contain HTML
  reverse?: boolean;
  button?: {
      text: string;
      link: string;
    };
  }
import ParallelogramButton from './parallelogramButton.astro';

const { imageSrc, imageAlt, title, text, reverse = false, button= null } = Astro.props;
---

<div class="w-full justify-center items-center py-12 ">
  <div class={`bg-[#f5f5f5] text-black w-full flex flex-col md:flex-row ${reverse ? 'md:flex-row-reverse' : ''} dark:bg-[#181818] shadow-lg overflow-hidden dark:text-white`}>
    
    <!-- Image Block -->
    <div class="md:w-1/2 w-full">
      <img 
        src={imageSrc} 
        alt={imageAlt} 
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Text Block -->
    <!-- with button : without -->
    {button ? (
      <div class="md:w-1/2 w-full p-8 flex flex-col justify-center">
        <p class=" mb-4 " set:html={title}></p>
        <p class="text-[22.4px]" set:html={text}></p>
        <ParallelogramButton
          link={button.link}
          text={button.text}
        />
      </div>
    ) : (
      <div class="md:w-1/2 w-full p-8 flex flex-col justify-center">
        <h2 class="text-[35.2px] font-bold mb-4" set:html={title}></h2>
        <p class="text-[22.4px] " set:html={text}></p>
        {/* This part runs if button is falsy, but you're checking button again? */}
      </div>
    )}

  </div>
</div>