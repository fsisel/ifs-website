---
import {members} from "../tools/members";
import { tasks } from "../data/members_tasks";
import genreralAIMember from "../../public/images/General_AIMember.webp"; 


export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof tasks;
const { lang } = Astro.params as { lang: Lang };
const t = tasks[lang] ?? tasks.en;

interface Member {
    name: string;
    task: string;
    Email: string;
    picture: string;
    contact: string;
}

const getGroupedMembers = (deptMembers: Member[]) => {
  const dts = deptMembers.filter(m => m.task.toLowerCase() === 'dt' || m.task.toLowerCase() === 'headooperations');
  const others = deptMembers.filter(m => m.task.toLowerCase() !== 'dt' && m.task.toLowerCase() !== 'headooperations');
  
  const grouped = others.reduce((acc, member) => {
    const key = t[member.task as keyof typeof t] || member.task;
    if (!acc[key]) acc[key] = [];
    acc[key].push(member);
    return acc;
  }, {} as Record<string, Member[]>);

  return { dts, grouped };
};
---

<style>
  .org-tree > ul::before { display: none; }
  .org-tree > ul > li::before,
  .org-tree > ul > li::after { display: none; }

  .org-tree ul {
    display: flex;
    position: relative;
    padding-top: 30px;
  }

  .org-tree li {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding: 25px 10px 0 10px;
  }

  .org-tree .node {
    padding: 0.85rem;
    border-radius: 0.75rem;
    min-width: 170px;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .org-tree li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 25px;
    border-left: 2px solid #555;
  }

  .org-tree li::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0;
    border-top: 2px solid #555;
  }

  .org-tree ul::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 30px;
    border-left: 2px solid #555;
  }

  .org-tree li:first-child::after { left: 50%; border-radius: 10px 0 0 0; }
  .org-tree li:last-child::after  { right: 50%; border-radius: 0 10px 0 0; }

  .org-tree li:only-child::after  { display: none; }
  .org-tree li:only-child::before { display: none; }
  .org-tree li:only-child         { padding-top: 0; }

  .org-tree li.trunk { padding-top: 0; }
  .org-tree li.trunk::before,
  .org-tree li.trunk::after { display: none; }

  .org-tree li.trunk > ul:first-child::before { display: none; }

  .org-tree .trunk-stem {
    width: 0;
    height: 30px;
    align-self: center;
  }

  .org-tree li.trunk > ul + ul::before { display: none; }

  .org-tree li.trunk > ul:first-child {
    padding-top: 0;
    align-items: flex-end;
  }
  .org-tree li.trunk > ul:first-child > li {
    padding-top: 0;
    padding-bottom: 0;
  }
  .org-tree li.trunk > ul:first-child > li::before {
    display: block !important;
    top: auto;
    bottom: -30px;
    height: 30px;
  }
  .org-tree li.trunk > ul:first-child > li::after {
    top: auto;
    bottom: -30px;
    border-top: none;
    border-bottom: 2px solid #555;
  }
  .org-tree li.trunk > ul:first-child > li:first-child::after {
    left: 50%;
    border-radius: 0 0 0 10px;
  }
  .org-tree li.trunk > ul:first-child > li:last-child::after {
    right: 50%;
    border-radius: 0 0 10px 0;
  }

  /* Scroll container */
  .org-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .org-scroll.dragging {
    cursor: grabbing;
  }
  .org-scroll::-webkit-scrollbar { display: none; }

  /* Inner wrapper — centers when smaller than container, scrolls when larger */
  .org-inner {
    display: flex;
    justify-content: center;
    min-width: 100%;
    width: max-content;
    padding: 0 2rem;
  }

  summary::-webkit-details-marker { display: none; }
</style>

<script>
  function initDragScroll(el: HTMLElement) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    el.addEventListener('mousedown', (e) => {
      isDown = true;
      el.classList.add('dragging');
      startX = e.pageX - el.offsetLeft;
      scrollLeft = el.scrollLeft;
    });

    el.addEventListener('mouseleave', () => {
      isDown = false;
      el.classList.remove('dragging');
    });

    el.addEventListener('mouseup', () => {
      isDown = false;
      el.classList.remove('dragging');
    });

    el.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - el.offsetLeft;
      const walk = (x - startX) * 1.5;
      el.scrollLeft = scrollLeft - walk;
    });
  }

  function centerScroll(el: HTMLElement) {
    el.scrollLeft = (el.scrollWidth - el.clientWidth) / 2;
  }

  document.querySelectorAll<HTMLElement>('.org-scroll').forEach(initDragScroll);

  document.querySelectorAll('details').forEach((details) => {
    details.addEventListener('toggle', () => {
      details.querySelectorAll<HTMLElement>('.org-scroll').forEach((el) => {
        initDragScroll(el);
        // Wait one frame for layout to settle before centering
        requestAnimationFrame(() => centerScroll(el));
      });
    });
  });
</script>

<div class="max-w-7xl mx-auto space-y-6 p-4">
  {Object.entries(members["06"]).map(([deptName, deptMembers]) => {
    const { dts, grouped } = getGroupedMembers(deptMembers);
    const hasMultipleDTs = dts.length > 1;

    return (
      <details class="group border border-gray-800 bg-[#222222] rounded-xl overflow-hidden shadow-lg">
        <summary class="flex justify-between items-center p-6 cursor-pointer list-none hover:bg-[#2a2a2a] transition-colors">
          <div class="flex items-center gap-5">
            <span class="skewed"></span>
            <h2 class="text-white text-3xl font-extrabold uppercase tracking-wider">{deptName}</h2>
          </div>
          <svg class="w-7 h-7 text-[#f50] transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="p-8 bg-black/30 border-t border-gray-800">
          <div class="org-scroll">
            <div class="org-inner">
              <div class="org-tree px-4">
                <ul>
                  {hasMultipleDTs ? (
                    <li class="trunk">
                      <ul>
                        {dts.map((dt) => (
                          <li>
                            <div class="node bg-[#f50] text-white ring-4 ring-orange-500/20 shadow-[0_0_20px_rgba(255,85,0,0.3)] flex flex-col items-center">
                              <img src={dt.picture || genreralAIMember.src} alt={dt.name} class="w-35 md:w-32.5">
                              <h3 class="text-xl font-bold">{dt.name}</h3>
                              <p class="text-xs uppercase tracking-widest font-black opacity-90">{t[dt.task as keyof typeof t] || dt.task}</p>
                              {dt.contact && <p class="text-[10px] opacity-70 font-mono mt-1">{dt.contact}</p>}
                            </div>
                          </li>
                        ))}
                      </ul>

                      <div class="trunk-stem"></div>

                      <ul>
                        {Object.entries(grouped).map(([taskName, people]) => (
                          <li>
                            <div class="node bg-white text-black border-2 border-[#f50]/30">
                              <h4 class="text-sm font-black uppercase text-[#f50]">{t[taskName as keyof typeof t] || taskName}</h4>
                            </div>
                            <ul>
                              {people.map((person) => (
                                <li>
                                  <div class="node bg-[#333] text-white border border-gray-700">
                                    <h5 class="font-bold text-sm">{person.name}</h5>
                                    {person.contact && <p class="text-[10px] text-gray-400 font-mono">{person.contact}</p>}
                                  </div>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li>
                      <div class="node bg-[#f50] text-white ring-4 ring-orange-500/20 shadow-[0_0_20px_rgba(255,85,0,0.3)] flex flex-col items-center">
                        <img src={dts[0]?.picture || genreralAIMember.src} alt={dts[0]?.name} class="w-35 md:w-32.5">
                        <h3 class="text-xl font-bold">{dts[0]?.name}</h3>
                        <p class="text-xs uppercase tracking-widest font-black opacity-90">{t[dts[0]?.task as keyof typeof t] || dts[0]?.task}</p>
                        {dts[0]?.contact && <p class="text-[10px] opacity-70 font-mono mt-1">{dts[0].contact}</p>}
                      </div>
                      <ul>
                        {Object.entries(grouped).map(([taskName, people]) => (
                          <li>
                            <div class="node bg-white text-black border-2 border-[#f50]/30">
                              <h4 class="text-sm font-black uppercase text-[#f50]">{t[taskName as keyof typeof t] || taskName}</h4>
                            </div>
                            <ul>
                              {people.map((person) => (
                                <li>
                                  <div class="node bg-[#333] text-white border border-gray-700">
                                    <h5 class="font-bold text-sm">{person.name}</h5>
                                    {person.contact && <p class="text-[10px] text-gray-400 font-mono">{person.contact}</p>}
                                  </div>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ))}
                      </ul>
                    </li>
                  )}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </details>
    );
  })}
</div>
