---
import { translations } from "../i18n/translations";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;

const otherLang = lang === "en" ? "pt" : "en";

const url = Astro.url.pathname;          // /en/about_us
const segments = url.split("/");

const currentLang = segments[1];         // en

segments[1] = otherLang;

const switchUrl = segments.join("/");





//to remove no children error
export interface Props {
  children?: any;
}
---

<!-- header -->
<nav class="transition duration-200 w-full bg-black opacity-85 shadow-md fixed top-0 left-0 z-50 text-white" id="navbar">
	<div class=" mx-auto px-4 lg:px-8">
		<!-- Header -->
		<div class="flex items-center justify-between h-16">

			<!-- Logo -->
			<div class="flex items-center gap-3">
				<a href={`/${lang}/`}>
					<img src="/logos/ifs_icon_dark.svg" alt="ISEL Formula Student" class="h-6 w-auto" />
				</a>
			</div>
			<div class="flex items-end gap-8">
				<div class="hidden md:flex items-center gap-8 text-sm font-bold tracking-wide text-[16px]">
					<a href={`/${lang}/about_us`} class="hover:text-orange-500 transition">
					{t.aboutUs}
					</a>
					<a href={`/${lang}/ifs05`} class="hover:text-orange-500 transition">
					IFS05
					</a>
					<a href={`/${lang}/sponsors`} class="hover:text-orange-500 transition">
					{t.sponsors}
					</a>
					<a href={`/${lang}/contacts`} class="hover:text-orange-500 transition">
					{t.contacts}
					</a>
				</div>
			
				<div class="flex items-center gap-4">
					<!-- Language Switch -->
					<a href={switchUrl} title="Português">
						<img src={`/icons/${otherLang}.svg`} alt="Portuguese" class="h-6 w-6 rounded-sm" />
					</a>
					<!-- Mobile Menu Button -->
					<button
					id="menu_button"
					class="md:hidden flex items-center gap-2 text-sm font-semibold"
					>
						MENU
						<img src="/icons/menu.svg" alt="Menu" class="h-5 w-5" />
					</button>

				</div>	
			</div>	
		</div>	
	</div>
</nav>