---
import { translations } from "../i18n/translations";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "pt" } },
  ];
}
type Lang = keyof typeof translations;

const { lang } = Astro.params as { lang: Lang };
const t = translations[lang] ?? translations.en;

const otherLang = lang === "en" ? "pt" : "en";

const url = Astro.url.pathname;          // /en/about_us
const segments = url.split("/");

const currentLang = segments[1];         // en

segments[1] = otherLang;

const switchUrl = segments.join("/");





//to remove no children error
export interface Props {
  children?: any;
}
---
<script>
  const button = document.getElementById("menu_button")
  const menu = document.getElementById("mobile_menu")
  const icon = document.getElementById("menu_icon")

  button?.addEventListener("click", () => {
    menu?.classList.toggle("hidden")

	button?.classList.toggle("bg-white")
    button?.classList.toggle("text-white")

    icon?.classList.toggle("invert")
    icon?.classList.toggle("rotate-180")
  })
</script>
<!-- header -->
<nav class=" transition duration-200 w-full bg-[#000000d2] shadow-md fixed top-0 left-0 z-50 text-white" id="navbar">
	<div class=" mx-auto px-4 lg:px-8">
		<!-- Header -->
		<div class="flex items-center justify-between h-16">

			<!-- Logo -->
			<div class="flex items-center gap-3">
				<a href={`/${lang}/`}>
					<img src="/logos/ifs_icon_dark.svg" alt="ISEL Formula Student" class="h-6 w-auto" loading="eager" />
				</a>
			</div>
			<div class="flex items-end gap-8">
				<div class="hidden md:flex items-center gap-8 text-sm font-bold tracking-wide text-[16px]">
					<a href={`/${lang}/about_us`} class="hover:text-orange-500 transition">
					{t.aboutUs}
					</a>
					<a href={`/${lang}/ifs05`} class="hover:text-orange-500 transition">
					IFS05
					</a>
					<a href={`/${lang}/sponsors`} class="hover:text-orange-500 transition">
					{t.sponsors}
					</a>
					<a href={`/${lang}/contacts`} class="hover:text-orange-500 transition">
					{t.contacts}
					</a>
				</div>
			
				<div class="flex items-center gap-4">
					<!-- Language Switch -->
					<a href={switchUrl} title="Português">
						<img src={`/icons/${otherLang}.svg`} alt="Portuguese" class="h-6 w-6 rounded-sm" />
					</a>
					<!-- Mobile Menu Button -->
					<button
					id="menu_button"
  					class="md:hidden flex items-center gap-2 text-sm font-semibold text-black bg-white rounded-4xl px-3 py-2 transition bg-[#f50]"
					>
						MENU
						<img src="/icons/menu.svg" alt="Menu" class="h-3 w-3 invert transition-transform" id="menu_icon"/>
					</button>
				</div>	
			</div>	
		</div>	
	</div>
	<!-- Mobile dropdown -->
	<div
	id="mobile_menu"
	class="hidden md:hidden w-full flex flex-col text-left font-bold text-[16px]  text-white mt-4"
	>
	<a href={`/${lang}/about_us`} class="px-6 py-4 ">
		{t.aboutUs}
	</a>

	<a href={`/${lang}/ifs05`} class="px-6 py-4 ">
		IFS05
	</a>

	<a href={`/${lang}/sponsors`} class="px-6 py-4 ">
		{t.sponsors}
	</a>

	<a href={`/${lang}/contacts`} class="px-6 py-4 ">
		{t.contacts}
	</a>
	</div>
</nav>